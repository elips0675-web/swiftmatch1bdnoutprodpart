# =============================================================================
# SwiftMatch — Пример окружения (.env.example)
# Скопируйте в `.env` для локального запуска и в Secrets CI/CD для продакшена.
#   cp .env.example .env
# ВАЖНО: секреты (всё ниже `### SECRETS ###`) никогда не выкладывать в git.
# VITE_* переменные попадают в клиентский бандл — их НЕ хранить секретами.
# =============================================================================

# --- Общие / режим ----------------------------------------------------------
NODE_ENV=development

# --- Сервер (порт/бд/redis) -------------------------------------------------
PORT=3002
CLIENT_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:8081

# MariaDB/MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=swiftmatch
DB_POOL_MAX=10

# Redis (кэш, BFF, гонки)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# Авторизация. СГЕНЕРИРУЙТЕ длинный случайный секрет (>=32 символа):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Логирование: debug | info | warn | error
LOG_LEVEL=info

# --- Защита / безопасность --------------------------------------------------
SECURITY_HEADERS_API=true
# Блокировка аккаунта после N неудачных входов (0 = выкл)
AUTH_LOCKOUT_MAX_ATTEMPTS=5

# --- Опциональные интеграции (пустые = фолбэк/выключено) --------------------
# # Google Safe Browsing / AI-модерация (модерация контента)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# # Анализ текста через Perspective API
# PERSPECTIVE_API_KEY=

# # SMS (Twilio) для верификации телефона
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# # Push уведомления (Web Push / FCM)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# FCM_SERVER_KEY=

# # E-mail (SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@swiftmatch.app
# EMAIL_FROM=no-reply@swiftmatch.app

# # S3 / загрузка файлов в облако
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# S3_BUCKET=

# # Бэкапы БД (mysqldump)
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=7
# MYSQLDUMP_PATH=mysqldump

# --- Платежи (монетизация) ---------------------------------------------------
# Stripe (веб). STRIPE_LIVE=true переключает в live-режим.
# STRIPE_LIVE=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# # RevenueCat IAP (нативные iOS/Android), веб-хук для синхронизации
# REVENUECAT_WEBHOOK_SECRET=

# --- Мониторинг (Sentry) -----------------------------------------------------
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =============================================================================
### SECRETS ### Локально не заполнять значениями — все ниже в Secrets CI/CD ###
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_SSH_KEY=

# =============================================================================
# --- Клиент (VITE_* — попадают в браузер, НЕ секреты) -------------------------
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3002
VITE_APP_NAME=SwiftMatch
VITE_APP_VERSION=1.0.0
VITE_IMAGE_BASE_URL=/demo/people
VITE_PAGINATION_LIMIT=20
VITE_CHAT_POLL_INTERVAL=3000
VITE_SESSION_TIMEOUT=3600000

# # Push (public key федерации веб-пуша — можно хранить открыто)
# VITE_VAPID_PUBLIC_KEY=

# # Supabase (опционально; проект использует dev-login фолбэк)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# # VITE_SUPABASE_SERVICE_ROLE_KEY only server-side, никогда в веб-бандл

# # RevenueCat IAP (нативные iOS/Android только; веб использует Stripe/mock)
# VITE_REVENUECAT_API_KEY=appl_xxx_xxx

# # Sentry (публичный DSN — клиент)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
