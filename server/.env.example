# ──────────────────────────────────────────────
# SwiftMatch API — Environment Variables
# Copy to .env and fill values before starting
# ──────────────────────────────────────────────

# Server
PORT=3002
JWT_SECRET=change-this-to-a-random-256-bit-secret
CORS_ORIGIN=http://localhost:8081
NODE_ENV=development
LOG_LEVEL=info
# AUTH_LOCKOUT_MAX_ATTEMPTS=5   # failed logins before temporary lockout (default 5)
# SWAGGER_URL=https://api.example.com   # overrides swagger "servers" host (defaults to API_URL/PORT)

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=swiftmatch
# DB_POOL_MAX=20          # connection pool size (default 20; consider 10 under k6 load)

# Backups (admin web UI — POST /api/admin/backup)
# BACKUP_DIR=./backups           # where mysqldump dumps are stored (default <repo>/backups)
# BACKUP_RETENTION_DAYS=30       # auto-prune backups older than this (default 30)
# MYSQLDUMP_PATH=                # optional explicit path to mysqldump binary (auto-detected otherwise)

# VAPID (push notifications)
# Regenerate for each environment: npx web-push generate-vapid-keys
# Private key is SECRET — keep only in .env (gitignored), never commit the real one.
VAPID_PUBLIC_KEY=change-me-generate-with-web-push
VAPID_PRIVATE_KEY=change-me-generate-with-web-push
VAPID_SUBJECT=mailto:admin@swiftmatch.app

# SMTP (email verification / password reset)
# Dev: use Mailtrap (smtp.mailtrap.io, any user/pass works for catch-all)
# Prod: Resend / SES / SendGrid
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. mail.js falls back to EMAIL_FROM if SMTP_FROM is empty.
SMTP_FROM=noreply@swiftmatch.app
# EMAIL_FROM=noreply@swiftmatch.app

# Admin bootstrap email (login for the first-admin / dev-login target)
ADMIN_EMAIL=admin@swiftmatch.app

# Stripe (live keys for production, empty = mock mode)
# STRIPE_LIVE=true     # uncomment to disable mock fallback (requires valid keys)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry (backend error monitoring)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Redis (distributed rate-limit + session cache)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=60              # default cache TTL in seconds

# S3 / DigitalOcean Spaces / Selectel (file uploads)
# NOTE: code reads AWS_REGION (not S3_REGION) — see upload.js / ai-moderation.js
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=us-east-1           # region the bucket lives in (default us-east-1)
# S3_BUCKET=swiftmatch-uploads
# S3_ENDPOINT=https://s3.amazonaws.com   # custom endpoint for DO/Selectel/Yandex

# Twilio (SMS verification)
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+1234567890

# AI Moderation (text via OpenAI Moderations API / image via AWS Rekognition)
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini        # model for icebreakers (default gpt-4o-mini)
# PERSPECTIVE_API_KEY=xxx

# Firebase Cloud Messaging (push notifications for Android APK)
# FCM_SERVER_KEY=AAAAxxx
# FCM_SERVICE_ACCOUNT=   # service account для серверной отправки — base64 от JSON, сырой JSON или путь к .json

# RevenueCat (IAP for Apple/Google in-app purchases)
# REVENUECAT_WEBHOOK_SECRET=xxx
